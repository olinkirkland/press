{
    "name": "kirkland-press-site",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "deploy": "npm run prepare && npm run build && gh-pages -d dist",
        "prepare": "node scripts/fetch-itch-products.mjs"
    },
    "dependencies": {
        "gh-pages": "^6.3.0",
        "tailwindcss": "^4.3.2",
        "vue": "^3.5.38",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.2",
        "@tailwindcss/vite": "^4.3.2",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.13.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/tsconfig": "^0.9.1",
        "node-html-to-image": "^6.2.0",
        "npm-run-all2": "^9.0.2",
        "prettier": "3.8.4",
        "sass-embedded": "^1.100.0",
        "typescript": "~6.0.0",
        "vite": "^8.0.16",
        "vue-tsc": "^3.3.5"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true,
        "fsevents@2.3.3": true
    }
}
